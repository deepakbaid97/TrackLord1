# TrackLord Web Frontend - Environment Configuration Example

# Backend API Base URL
VITE_API_BASE=/api

# Server-side Vaani API key for local development. Do not prefix with VITE_.
# In deployed environments, set VAANI_API_KEY on the TrackLord API host.
VAANI_API_KEY=your_vaani_api_key_here

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
